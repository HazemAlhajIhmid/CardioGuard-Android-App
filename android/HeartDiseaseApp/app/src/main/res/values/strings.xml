    <!-- About Activity -->
    <string name="about_title">حول مشروع CardioGuard</string>
    <string name="about_description">هذا المشروع هو جزء من رسالة ماجستير في علوم البيانات، ويهدف إلى تطوير نظام ذكي للمساعدة في الكشف المبكر عن أمراض القلب.</string>
    <string name="about_section_methodology_title">منهجية البحث</string>
    <string name="about_methodology_1_title">جمع البيانات</string>
    <string name="about_methodology_1_desc">تم استخدام مجموعة بيانات أمراض القلب من جامعة كاليفورنيا في إيرفاين (UCI).</string>
    <string name="about_methodology_2_title">معالجة البيانات</string>
    <string name="about_methodology_2_desc">تنظيف البيانات ومعالجة القيم المفقودة وتطبيع الميزات لتحسين أداء النماذج.</string>
    <string name="about_methodology_3_title">تدريب النماذج</string>
    <string name="about_methodology_3_desc">تم تدريب ثلاثة نماذج مختلفة لتعلم الآلة: K-Nearest Neighbors, Naive Bayes, و Decision Tree.</string>
    <string name="about_methodology_4_title">التقييم</string>
    <string name="about_methodology_4_desc">تقييم أداء النماذج باستخدام مقاييس الدقة، الاستدعاء، والمقياس F1.</string>
    <string name="about_section_features_title">الميزات الرئيسية</string>
    <string name="about_feature_1_title">دقة عالية</string>
    <string name="about_feature_1_desc">تصل الدقة إلى 82% مع نماذج KNN و Naive Bayes.</string>
    <string name="about_feature_2_title">تنبؤ سريع</string>
    <string name="about_feature_2_desc">نتائج فورية باستخدام خوارزميات مُحسَّنة.</string>
    <string name="about_feature_3_title">تكلفة قابلة للتطوير</string>
    <string name="about_feature_3_desc">يعتمد على تقنيات مفتوحة المصدر لتقليل التكاليف.</string>
