    <!-- Info Dialogs -->
    <string name="info_title_age">About Age</string>
    <string name="info_desc_age">Enter your age in years. Age is a significant risk factor for heart disease.</string>
    <string name="info_title_sex">About Sex</string>
    <string name="info_desc_sex">Select your gender. The risk of heart disease differs between men and women.</string>
    <string name="info_title_chest_pain">About Chest Pain Type</string>
    <string name="info_desc_chest_pain">Choose the type of chest pain you experience.\n- Typical Angina: Chest pain that occurs with exertion.\n- Atypical Angina: Chest pain not necessarily related to exertion.\n- Non-anginal Pain: Chest pain not related to the heart.\n- Asymptomatic: No chest pain.</string>
    <string name="info_title_trestbps">About Resting Blood Pressure</string>
    <string name="info_desc_trestbps">Enter your resting systolic blood pressure (the upper number). A normal value is less than 120 mmHg.</string>
    <string name="info_title_cholesterol">About Cholesterol</string>
    <string name="info_desc_cholesterol">Enter your serum cholesterol level. A desirable level is less than 200 mg/dl.</string>
    <string name="info_title_fasting_blood_sugar">About Fasting Blood Sugar</string>
    <string name="info_desc_fasting_blood_sugar">Indicate if your fasting blood sugar is greater than 120 mg/dl. A normal level is less than 100 mg/dl.</string>
    <string name="info_title_rest_ecg">About Resting ECG</string>
    <string name="info_desc_rest_ecg">Choose your resting electrocardiographic result.\n- Normal: No abnormalities.\n- ST-T wave abnormality: Minor changes that may indicate issues.\n- Left ventricular hypertrophy: May indicate a thickening of the heart muscle.</string>
    <string name="info_title_max_heart_rate">About Maximum Heart Rate</string>
    <string name="info_desc_max_heart_rate">Enter the highest heart rate achieved during a stress test.</string>
    <string name="info_title_exercise_angina">About Exercise Induced Angina</string>
    <string name="info_desc_exercise_angina">Indicate if you experience chest pain (angina) during exercise.</string>
    <string name="info_title_oldpeak">About ST Depression (Oldpeak)</string>
    <string name="info_desc_oldpeak">Enter the value of ST depression induced by exercise relative to rest. A normal value is close to 0.</string>
    <string name="info_title_slope">About Slope of the ST segment</string>
    <string name="info_desc_slope">Choose the slope of the peak exercise ST segment on the ECG.</string>
    <string name="info_title_ca">About Number of Major Vessels</string>
    <string name="info_desc_ca">Enter the number of major vessels (0-3) colored by fluoroscopy.</string>
    <string name="info_title_thal">About Thalassemia</string>
    <string name="info_desc_thal">Choose the result of the Thalassemia test (a blood disorder).\n- Normal: Normal blood flow.\n- Fixed defect: Part of the heart muscle permanently lacks adequate blood flow.\n- Reversible defect: Part of the heart muscle lacks adequate blood flow only during stress.</string>

