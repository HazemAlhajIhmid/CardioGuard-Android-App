    <!-- About Activity -->
    <string name="about_title">About the CardioGuard Project</string>
    <string name="about_description">This project is part of a Master\'s thesis in Data Science, aimed at developing an intelligent system to aid in the early detection of heart disease.</string>
    <string name="about_section_methodology_title">Research Methodology</string>
    <string name="about_methodology_1_title">Data Collection</string>
    <string name="about_methodology_1_desc">Utilized the Heart Disease dataset from the UCI Machine Learning Repository.</string>
    <string name="about_methodology_2_title">Data Preprocessing</string>
    <string name="about_methodology_2_desc">Cleaned data, handled missing values, and normalized features to improve model performance.</string>
    <string name="about_methodology_3_title">Model Training</string>
    <string name="about_methodology_3_desc">Trained three different machine learning models: K-Nearest Neighbors, Naive Bayes, and Decision Tree.</string>
    <string name="about_methodology_4_title">Evaluation</string>
    <string name="about_methodology_4_desc">Evaluated model performance using Accuracy, Precision, Recall, and F1-Score metrics.</string>
    <string name="about_section_features_title">Key Features</string>
    <string name="about_feature_1_title">High Accuracy</string>
    <string name="about_feature_1_desc">Achieves up to 82% accuracy with KNN and Naive Bayes models.</string>
    <string name="about_feature_2_title">Fast Prediction</string>
    <string name="about_feature_2_desc">Instant results using optimized algorithms.</string>
    <string name="about_feature_3_title">Scalable &amp; Cost-Effective</string>
    <string name="about_feature_3_desc">Built on open-source technologies to minimize costs.</string>
